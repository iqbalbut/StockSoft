# ---------- Core ----------
APP_URL=https://receipts.example.com
# openssl rand -base64 48
SESSION_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts every stored file and 2FA secrets.
# BACK THIS UP SEPARATELY: without it the stored documents cannot be decrypted.
ENCRYPTION_KEY=

# PostgreSQL (Supabase, Neon, Railway or the docker-compose db). Leave empty to use the embedded
# demo database at ./data/pglite (single process only, not for production).
DATABASE_URL=

# ---------- AI extraction ----------
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. medium is a good default; use high for messy backlogs.
EXTRACTION_EFFORT=medium
EXTRACTION_MAX_ATTEMPTS=3

# ---------- Storage ----------
# local | s3 (any S3-compatible service: AWS S3, Cloudflare R2, Backblaze B2, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/files
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---------- Background jobs ----------
# inline: the worker runs inside the web server (default, simplest). external: run `npm run worker` separately.
WORKER_MODE=inline
WORKER_CONCURRENCY=3

# ---------- Intake ----------
# Bearer token for POST /api/ingest/webhook (n8n, email-forwarding services, WhatsApp bot). openssl rand -hex 32
INGEST_API_KEY=
# Gmail + Drive (see docs/DEPLOYMENT.md → Google). Scopes: gmail.modify, drive.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_LABEL=Receipts
GMAIL_DONE_LABEL=Receipts/Processed
DRIVE_FOLDER_ID=
INGEST_POLL_MINUTES=10

# ---------- Demo ----------
# true: pre-fills the demo login and uses sample extraction when no ANTHROPIC_API_KEY is set.
DEMO_MODE=false

# ---------- docker-compose only ----------
POSTGRES_PASSWORD=
MINIO_ROOT_USER=receiptvault
MINIO_ROOT_PASSWORD=
